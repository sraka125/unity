# This is a .gitignore file for Unity projects
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uild/*
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/

# MemoryCaptures can get huge, they are not needed for collaboration
[Mm]emoryCaptures/

# Asset meta data should only be ignored in special cases, but here are some common ones:
# (Leave these commented out unless you know what you are doing)
# *.pid
# *.suo
# *.user
# *.userprefs

# Visual Studio cache/solution files
.vs/
*.csproj
*.sln
*.unityproj
*.suo
*.user
*.userprefs
*.unityproj.meta

# Rider
.idea/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.aider*
UnityExplorer.MelonLoader.Mono.zip
